{
  "outbounds": [
    {
      "protocol": "vless",
      "tag": "{{ xray_client_outbound_tag }}",
      "settings": {
        "vnext": [
          {
            "address": "{{ ansible_host | default(inventory_hostname) }}",
            "port": 443,
            "users": [
              {
                "id": "{{ xray_new_client_uuid }}",
                "encryption": "none",
                "flow": "{{ xray_client_flow }}"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "serverName": "{{ xray_reality_server_names[0] }}",
          "publicKey": "{{ xray_public_key }}",
          "fingerprint": "{{ xray_client_fingerprint }}",
          "shortId": "{{ xray_short_id }}",
          "spiderX": ""
        }
      }
    }
  ]
}
